mapHeight; z += 4) for (int x = 0; x < td.alphamapWidth; x += 4) { totalG++; if (alpha[z, x, 0] >= 0.55f) grass++; }\nsb.Append(\",\\\"grassFractionWholeMap\\\":\").Append((100f * grass / UnityEngine.Mathf.Max(1, totalG)).ToString(\"F2\", System.Globalization.CultureInfo.InvariantCulture)).Append(\"%\");\nsb.Append(\",\\\"sceneDirty\\\":\").Append(UnityEngine.SceneManagement.SceneManager.GetActiveScene().isDirty ? \"true\" : \"false\");\nsb.Append('}');\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"}}
