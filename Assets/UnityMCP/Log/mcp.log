{"ts":"2026-11-16T22:55:31.296Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":4368,"action":"execute","params":{"action":"execute","code":"var guids = UnityEditor.AssetDatabase.FindAssets(\"t:Texture2D\", new[] { \"Assets\" });\nvar grassKeywords = new[] { \"grass\", \"grama\", \"lawn\", \"turf\", \"foliage_ground\" };\nvar asphaltKeywords = new[] { \"asphalt\", \"asfalto\", \"road\", \"concrete\", \"pavement\", \"street\" };\nvar dirtKeywords = new[] { \"dirt\", \"terra\", \"soil\", \"sand\", \"mud\", \"ground\" };\n\nvar grassList = new System.Collections.Generic.List<string>();\nvar asphaltList = new System.Collections.Generic.List<string>();\nvar dirtList = new System.Collections.Generic.List<string>();\n\nforeach (var g in guids) {\n    string p = UnityEditor.AssetDatabase.GUIDToAssetPath(g);\n    if (p.StartsWith(\"Assets/Mapas\")) continue;\n    string nameLower = System.IO.Path.GetFileNameWithoutExtension(p).ToLower();\n    \n    // Check if normal map or diffuse\n    var tex = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Texture2D>(p);\n    if (tex == null) continue;\n    \n    string info = tex.name + \" (\" + tex.width + \"x\" + tex.height + \") @ \" + p;\n    \n    foreach (var k in grassKeywords) {\n        if (nameLower.Contains(k)) { grassList.Add(info); break; }\n    }\n    foreach (var k in asphaltKeywords) {\n        if (nameLower.Contains(k)) { asphaltList.Add(info); break; }\n    }\n    foreach (var k in dirtKeywords) {\n        if (nameLower.Contains(k)) { dirtList.Add(info); break; }\n    }\n}\n\nreturn \"GRASS candidates (\" + grassList.Count + \"):\\n\" + string.Join(\"\\n\", grassList) +\n       \"\\n\\nASPHALT candidates (\" + asphaltList.Count + \"):\\n\" + string.Join(\"\\n\", asphaltList) +\n       \"\\n\\nDIRT candidates (\" + dirtList.Count + \"):\\n\" + string.Join(\"\\n\", dirtList);","safety_checks":true,"compiler":"auto"}}
