{"ts":"2026-11-18T02:03:33.039Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":12216,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nsb.Append(\"playing=\").Append(UnityEditor.EditorApplication.isPlaying);\nsb.Append(\" scene=\").Append(UnityEngine.SceneManagement.SceneManager.GetActiveScene().path);\nvar q = IF360.QuestManager.Instancia;\nsb.Append(\" quest=\").Append(q != null);\nif (q != null) {\n    sb.Append(\" total=\").Append(q.TotalMissoesCatalogo).Append(\" done=\").Append(q.QuantidadeMissoesCompletas());\n    var missoes = q.Motor.Catalogo.Missoes;\n    sb.Append(\" firstMission=\").Append(missoes.Count > 0 ? missoes[0].MissionId : \"NONE\");\n    sb.Append(\" firstStartNPC=\").Append(missoes.Count > 0 ? missoes[0].StartingNPCId : \"NONE\");\n}\nvar p = UnityEngine.GameObject.Find(\"PainelMissao\");\nsb.Append(\" || HUD active=\").Append(p != null && p.activeInHierarchy);\nif (p != null) foreach (var t in p.GetComponentsInChildren<TMPro.TMP_Text>(true))\n    sb.Append(\" | \").Append(t.name).Append(\"='\").Append(t.text).Append(\"'\");\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-11-18T02:03:52.834Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":5015,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar q = IF360.QuestManager.Instancia;\nvar p = UnityEngine.GameObject.Find(\"PainelMissao\");\nSystem.Action<string> dump = (tag) => {\n    sb.Append(\"\\n[\").Append(tag).Append(\"] hudActive=\").Append(p != null && p.activeInHierarchy);\n    if (p != null) foreach (var t in p.GetComponentsInChildren<TMPro.TMP_Text>(true))\n        sb.Append(\" | \").Append(t.name).Append(\"='\").Append(t.text).Append(\"'\");\n};\ndump(\"INICIAL\");\n\nvar dialogos = UnityEngine.Object.FindObjectsByType<IF360.DialogueUI>(UnityEngine.FindObjectsInactive.Include);\nsb.Append(\"\\ndialogos=\").Append(dialogos.Length);\nforeach (var d in dialogos) { d.Mostrar(); d.Esconder(); }\ndump(\"APOS_ABRIR_E_FECHAR_DIALOGO\");\n\nvar r = q.RegistrarEncerramentoDialogo(\"NPC_ANANDA\");\nsb.Append(\"\\nRegistrarEncerramento: result=\").Append(r.Resultado)\n  .Append(\" iniciada=\").Append(r.MissaoIniciada)\n  .Append(\" objetivo=\").Append(r.ObjetivoRegistrado)\n  .Append(\" etapa=\").Append(r.EtapaConcluida)\n  .Append(\" finalizada=\").Append(r.MissaoFinalizada);\nvar resumo = q.ObterResumoProgresso();\nsb.Append(\"\\nresumo: ativa=\").Append(resumo.TemMissaoAtiva).Append(\" nome=\").Append(resumo.MissionName)\n  .Append(\" etapa=\").Append(resumo.StepOrder).Append(\"/\").Append(resumo.TotalEtapas)\n  .Append(\" desc=\").Append(resumo.StepDescricao);\ndump(\"MISSAO_INICIADA_OU_ETAPA\");\n\nq.CompletarMissao(\"missao_ensino_medio\");\ndump(\"MISSAO_COMPLETADA\");\nsb.Append(\"\\ncontador=\").Append(q.QuantidadeMissoesCompletas()).Append(\"/\").Append(q.TotalMissoesCatalogo);\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
