{"ts":"2026-11-17T02:19:23.652Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":4330,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar terrain = UnityEngine.Terrain.activeTerrain;\nvar td = terrain.terrainData;\nvar tpos = terrain.transform.position;\nint grassLayer = 0;\nfor (int i = 0; i < td.terrainLayers.Length; i++) {\n    if (td.terrainLayers[i] != null && td.terrainLayers[i].name.ToLower().Contains(\"grama\")) { grassLayer = i; break; }\n}\n\nvar org = UnityEngine.GameObject.Find(\"Vegetacao_Gramado_Nordeste\");\nsb.Append(\"{\\\"organizer\\\":\").Append(org != null ? \"true\" : \"false\");\nif (org == null) { sb.Append(\"}\"); return sb.ToString(); }\nsb.Append(\",\\\"savedSceneExists\\\":\").Append(System.IO.File.Exists(@\"C:\\projetos\\IF 360\\Assets\\Scenes\\Campus.unity\") ? \"true\" : \"false\");\n\nint total = 0, linked = 0, unlinked = 0, noRenderer = 0;\nfloat maxSnapErr = 0f;\nfloat minBase = float.MaxValue, maxBase = float.MinValue;\nint floating = 0, splatBad = 0;\nvar perGroup = new System.Text.StringBuilder();\nbool fg = true;\nforeach (UnityEngine.Transform g in org.transform) {\n    if (!fg) perGroup.Append(',');\n    fg = false;\n    perGroup.Append('\"').Append(g.name).Append(\"\\\":\").Append(g.childCount);\n}\nforeach (UnityEngine.Transform g in org.transform) {\n    foreach (UnityEngine.Transform c in g) {\n        total++;\n        var go = c.gameObject;\n        if (UnityEditor.PrefabUtility.GetCorrespondingObjectFromSource(go) != null) linked++; else unlinked++;\n        var rs = go.GetComponentsInChildren<UnityEngine.Renderer>();\n        if (rs.Length == 0) { noRenderer++; continue; }\n        var b = rs[0].bounds;\n        for (int i = 1; i < rs.Length; i++) b.Encapsulate(rs[i].bounds);\n        float gy = terrain.SampleHeight(new UnityEngine.Vector3(c.position.x, 0f, c.position.z)) + tpos.y + 0.10f;\n        float err = b.min.y - (gy - 0.07f);\n        if (UnityEngine.Mathf.Abs(err) > UnityEngine.Mathf.Abs(maxSnapErr)) maxSnapErr = err;\n        if (b.min.y > gy + 0.10f) floating++;\n        minBase = UnityEngine.Mathf.Min(minBase, b.min.y);\n        maxBase = UnityEngine.Mathf.Max(maxBase, b.min.y);\n        float nx = (c.position.x - tpos.x) / td.size.x;\n        float nz = (c.position.z - tpos.z) / td.size.z;\n        if (nx >= 0f && nx <= 1f && nz >= 0f && nz <= 1f) {\n            int px = UnityEngine.Mathf.Clamp(UnityEngine.Mathf.RoundToInt(nx * (td.alphamapWidth - 1)), 0, td.alphamapWidth - 1);\n            int pz = UnityEngine.Mathf.Clamp(UnityEngine.Mathf.RoundToInt(nz * (td.alphamapHeight - 1)), 0, td.alphamapHeight - 1);\n            if (td.GetAlphamaps(px, pz, 1, 1)[0, 0, grassLayer] < 0.55f) splatBad++;\n        }\n    }\n}\nsb.Append(\",\\\"groups\\\":{\").Append(perGroup.ToString()).Append('}');\nsb.Append(\",\\\"total\\\":\").Append(total);\nsb.Append(\",\\\"prefabLinked\\\":\").Append(linked);\nsb.Append(\",\\\"prefabUnlinked\\\":\").Append(unlinked);\nsb.Append(\",\\\"noRenderer\\\":\").Append(noRenderer);\nsb.Append(\",\\\"maxSnapErr\\\":\").Append(maxSnapErr.ToString(\"F4\", System.Globalization.CultureInfo.InvariantCulture));\nsb.Append(\",\\\"floatingAboveGround10cm\\\":\").Append(floating);\nsb.Append(\",\\\"splatBelow055\\\":\").Append(splatBad);\nsb.Append(\",\\\"baseYRange\\\":\\\"\").Append(minBase.ToString(\"F3\")).Append(\"..\").Append(maxBase.ToString(\"F3\")).Append(\"\\\"\");\nsb.Append(\",\\\"sceneObjects\\\":\").Append(UnityEngine.Object.FindObjectsByType<UnityEngine.GameObject>(UnityEngine.FindObjectsInactive.Include).Length);\nsb.Append(\",\\\"sceneDirty\\\":\").Append(UnityEngine.SceneManagement.SceneManager.GetActiveScene().isDirty ? \"true\" : \"false\");\nsb.Append('}');\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"}}
