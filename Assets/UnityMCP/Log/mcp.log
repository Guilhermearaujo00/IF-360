{"ts":"2026-11-16T22:29:35.273Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":81135,"action":"execute","params":{"action":"execute","code":"var lights = UnityEngine.Object.FindObjectsByType<Light>(FindObjectsInactive.Include, FindObjectsSortMode.None);\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"Total lights: \" + lights.Length);\nforeach (var l in lights) {\n    sb.AppendLine(string.Format(\"Light: '{0}', Type: {1}, Intensity: {2}, Shadows: {3}, Active: {4}\",\n        l.gameObject.name, l.type, l.intensity, l.shadows, l.gameObject.activeInHierarchy));\n}\nvar srp = UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline;\nsb.AppendLine(\"Current SRP: \" + (srp != null ? srp.GetType().Name : \"Built-in\"));\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
