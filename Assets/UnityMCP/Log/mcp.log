{"ts":"2026-11-16T23:06:23.904Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":2778,"action":"execute","params":{"action":"execute","code":"var t = UnityEngine.Terrain.activeTerrain;\nvar td = t.terrainData;\nint w = td.alphamapWidth;\nint h = td.alphamapHeight;\nfloat[,,] maps = td.GetAlphamaps(0, 0, w, h);\n\nfloat sum0 = 0f, sum1 = 0f, sum2 = 0f;\nfor (int y = 0; y < h; y += 16) {\n    for (int x = 0; x < w; x += 16) {\n        sum0 += maps[y, x, 0];\n        sum1 += maps[y, x, 1];\n        sum2 += maps[y, x, 2];\n    }\n}\nfloat total = sum0 + sum1 + sum2;\nreturn \"Alphamap Sampled Stats:\\n\" +\n       \"Layer 0 (Grama)  : \" + (sum0 * 100f / total).ToString(\"F2\") + \"%\\n\" +\n       \"Layer 1 (Asfalto): \" + (sum1 * 100f / total).ToString(\"F2\") + \"%\\n\" +\n       \"Layer 2 (Terra)  : \" + (sum2 * 100f / total).ToString(\"F2\") + \"%\";","safety_checks":true,"compiler":"auto"}}
