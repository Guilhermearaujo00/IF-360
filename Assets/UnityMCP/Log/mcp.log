{"ts":"2026-11-16T23:10:30.850Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":88148,"action":"execute","params":{"action":"execute","code":"var guids = UnityEditor.AssetDatabase.FindAssets(\"t:Prefab t:Model\", new[] { \"Assets\" });\nvar treeKeywords = new[] { \"tree\", \"arvore\", \"pine\", \"oak\", \"palm\", \"bush_large\" };\nvar rockKeywords = new[] { \"rock\", \"stone\", \"pedra\", \"boulder\", \"pebble\" };\nvar grassKeywords = new[] { \"grass\", \"grama\", \"plant\", \"weed\", \"fern\", \"bush\" };\n\nvar trees = new System.Collections.Generic.List<string>();\nvar rocks = new System.Collections.Generic.List<string>();\nvar grass = new System.Collections.Generic.List<string>();\n\nSystem.Func<UnityEngine.GameObject, int> getVertexCount = (go) => {\n    int count = 0;\n    var mfs = go.GetComponentsInChildren<UnityEngine.MeshFilter>(true);\n    foreach (var mf in mfs) {\n        if (mf.sharedMesh != null) count += mf.sharedMesh.vertexCount;\n    }\n    var smrs = go.GetComponentsInChildren<UnityEngine.SkinnedMeshRenderer>(true);\n    foreach (var smr in smrs) {\n        if (smr.sharedMesh != null) count += smr.sharedMesh.vertexCount;\n    }\n    return count;\n};\n\nforeach (var g in guids) {\n    string p = UnityEditor.AssetDatabase.GUIDToAssetPath(g);\n    if (!p.EndsWith(\".prefab\") && !p.EndsWith(\".fbx\") && !p.EndsWith(\".obj\")) continue;\n    string n = System.IO.Path.GetFileNameWithoutExtension(p).ToLower();\n    \n    var go = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.GameObject>(p);\n    if (go == null) continue;\n    int vCount = getVertexCount(go);\n    string info = go.name + \" (\" + vCount + \" verts) @ \" + p;\n    \n    foreach (var k in treeKeywords) {\n        if (n.Contains(k)) { trees.Add(info); break; }\n    }\n    foreach (var k in rockKeywords) {\n        if (n.Contains(k)) { rocks.Add(info); break; }\n    }\n    foreach (var k in grassKeywords) {\n        if (n.Contains(k)) { grass.Add(info); break; }\n    }\n}\n\nreturn \"TREES (\" + trees.Count + \"):\\n\" + string.Join(\"\\n\", trees) +\n       \"\\n\\nROCKS (\" + rocks.Count + \"):\\n\" + string.Join(\"\\n\", rocks) +\n       \"\\n\\nGRASS (\" + grass.Count + \"):\\n\" + string.Join(\"\\n\", grass);","safety_checks":true,"compiler":"auto"}}
{"ts":"2026-11-16T23:11:20.902Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":10339,"action":"execute","params":{"action":"execute","code":"var guids = UnityEditor.AssetDatabase.FindAssets(\"t:Prefab\", new[] { \"Assets/Vegetation_Stylized_Pack_ByLuxArtStudios\" });\nvar sb = new System.Text.StringBuilder();\n\nSystem.Func<UnityEngine.GameObject, int> getVertexCount = (go) => {\n    int count = 0;\n    var mfs = go.GetComponentsInChildren<UnityEngine.MeshFilter>(true);\n    foreach (var mf in mfs) {\n        if (mf.sharedMesh != null) count += mf.sharedMesh.vertexCount;\n    }\n    return count;\n};\n\nforeach (var g in guids) {\n    string p = UnityEditor.AssetDatabase.GUIDToAssetPath(g);\n    var go = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.GameObject>(p);\n    if (go != null) {\n        sb.AppendLine(go.name + \" (\" + getVertexCount(go) + \" verts) @ \" + p);\n    }\n}\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
