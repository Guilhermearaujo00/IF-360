{"ts":"2026-11-16T23:26:20.761Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":10099,"action":"execute","params":{"action":"execute","code":"var player = UnityEngine.GameObject.Find(\"Caio\") ?? UnityEngine.GameObject.FindWithTag(\"Player\");\nif (player == null) return \"No player\";\nvar pPos = player.transform.position;\n\nvar t = UnityEngine.Terrain.activeTerrain;\nvar td = t.terrainData;\nvar tPos = t.transform.position;\nvar tSize = td.size;\n\n// Find closest tree to player\nfloat minTreeDist = float.MaxValue;\nforeach (var tree in td.treeInstances) {\n    Vector3 worldTree = new Vector3(tPos.x + tree.position.x * tSize.x, tPos.y + tree.position.y * tSize.y, tPos.z + tree.position.z * tSize.z);\n    float d = UnityEngine.Vector3.Distance(pPos, worldTree);\n    if (d < minTreeDist) minTreeDist = d;\n}\n\n// Find closest rock to player\nfloat minRockDist = float.MaxValue;\nvar pedras = UnityEngine.GameObject.Find(\"Terrain_Vegetation_Props/Pedras\");\nif (pedras != null) {\n    for (int i = 0; i < pedras.transform.childCount; i++) {\n        float d = UnityEngine.Vector3.Distance(pPos, pedras.transform.GetChild(i).position);\n        if (d < minRockDist) minRockDist = d;\n    }\n}\n\nreturn \"Player at: \" + pPos + \"\\nClosest Tree: \" + minTreeDist.ToString(\"F1\") + \"m away\\nClosest Rock: \" + minRockDist.ToString(\"F1\") + \"m away\";","safety_checks":true,"compiler":"auto"}}
