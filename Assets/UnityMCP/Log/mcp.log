{"ts":"2026-11-16T22:49:21.691Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":10980,"action":"execute","params":{"action":"execute","code":"var guids = AssetDatabase.FindAssets(\"t:Texture2D\", new[] { \"Assets\" });\n\nSystem.Func<string[], string, (string path, Texture2D diffuse, Texture2D normal)> findBest = (keywords, excludeExt) => {\n    string bestPath = null;\n    Texture2D bestDiffuse = null;\n    int maxRes = -1;\n\n    foreach (var guid in guids) {\n        string p = AssetDatabase.GUIDToAssetPath(guid);\n        if (p.StartsWith(\"Assets/Mapas\", System.StringComparison.OrdinalIgnoreCase)) continue;\n        if (p.EndsWith(\".asset\", System.StringComparison.OrdinalIgnoreCase)) continue;\n\n        string fileName = System.IO.Path.GetFileNameWithoutExtension(p).ToLowerInvariant();\n        var imp = AssetImporter.GetAtPath(p) as TextureImporter;\n        bool isNormal = (imp != null && imp.textureType == TextureImporterType.NormalMap) ||\n                        fileName.EndsWith(\"_normal\") || fileName.EndsWith(\"_n\") || fileName.Contains(\"nor_gl\");\n\n        if (isNormal) continue;\n\n        bool matches = false;\n        foreach (var k in keywords) {\n            if (fileName.Contains(k)) { matches = true; break; }\n        }\n        if (!matches) continue;\n\n        var tex = AssetDatabase.LoadAssetAtPath<Texture2D>(p);\n        if (tex == null) continue;\n\n        int res = tex.width * tex.height;\n        if (res > maxRes) {\n            maxRes = res;\n            bestPath = p;\n            bestDiffuse = tex;\n        }\n    }\n\n    Texture2D normalTex = null;\n    if (bestPath != null) {\n        string dir = System.IO.Path.GetDirectoryName(bestPath);\n        foreach (var guid in guids) {\n            string np = AssetDatabase.GUIDToAssetPath(guid);\n            if (!np.StartsWith(dir, System.StringComparison.OrdinalIgnoreCase)) continue;\n            string nName = System.IO.Path.GetFileNameWithoutExtension(np).ToLowerInvariant();\n            var nImp = AssetImporter.GetAtPath(np) as TextureImporter;\n            bool isN = (nImp != null && nImp.textureType == TextureImporterType.NormalMap) ||\n                       nName.Contains(\"_nor\") || nName.Contains(\"_n\") || nName.Contains(\"normal\");\n            if (isN) {\n                var nt = AssetDatabase.LoadAssetAtPath<Texture2D>(np);\n                if (nt != null) {\n                    normalTex = nt;\n                    break;\n                }\n            }\n        }\n    }\n\n    return (bestPath, bestDiffuse, normalTex);\n};\n\nvar grass = findBest(new[] { \"grass\", \"grama\", \"lawn\", \"turf\", \"foliage_ground\" }, null);\nvar asphalt = findBest(new[] { \"asphalt\", \"asfalto\", \"road\", \"concrete\", \"pavement\", \"street\" }, null);\nvar dirt = findBest(new[] { \"dirt\", \"terra\", \"soil\", \"sand\", \"mud\", \"ground\" }, null);\n\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"Grama: \" + (grass.diffuse != null ? (grass.diffuse.name + \" (\" + grass.diffuse.width + \"x\" + grass.diffuse.height + \"), Normal: \" + (grass.normal != null ? grass.normal.name : \"null\")) : \"Fallback\"));\nsb.AppendLine(\"Asfalto: \" + (asphalt.diffuse != null ? (asphalt.diffuse.name + \" (\" + asphalt.diffuse.width + \"x\" + asphalt.diffuse.height + \"), Normal: \" + (asphalt.normal != null ? asphalt.normal.name : \"null\")) : \"Fallback\"));\nsb.AppendLine(\"Terra: \" + (dirt.diffuse != null ? (dirt.diffuse.name + \" (\" + dirt.diffuse.width + \"x\" + dirt.diffuse.height + \"), Normal: \" + (dirt.normal != null ? dirt.normal.name : \"null\")) : \"Fallback\"));\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
