{"ts":"2026-11-16T22:46:37.951Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":4165,"action":"execute","params":{"action":"execute","code":"var map = GameObject.Find(\"Mapa_IFNMG_Prototipo\");\nif (map == null) return \"Mapa_IFNMG_Prototipo not found\";\n\nvar renderers = map.GetComponentsInChildren<Renderer>();\nvar bounds = new Bounds(renderers[0].bounds.center, Vector3.zero);\nforeach (var r in renderers) {\n    bounds.Encapsulate(r.bounds);\n}\n\nvar terrenos = GameObject.Find(\"Mapa_IFNMG_Prototipo/Terrenos\");\nBounds bTerrenos = new Bounds();\nif (terrenos != null) {\n    var trs = terrenos.GetComponentsInChildren<Renderer>();\n    if (trs.Length > 0) {\n        bTerrenos = new Bounds(trs[0].bounds.center, Vector3.zero);\n        foreach (var r in trs) bTerrenos.Encapsulate(r.bounds);\n    }\n}\n\nreturn string.Format(\"Map Bounds: center {0}, size {1}, min {2}, max {3}\\nTerrenos Bounds: center {4}, size {5}, min {6}, max {7}\",\n    bounds.center, bounds.size, bounds.min, bounds.max,\n    bTerrenos.center, bTerrenos.size, bTerrenos.min, bTerrenos.max);","safety_checks":true,"compiler":"auto"}}
