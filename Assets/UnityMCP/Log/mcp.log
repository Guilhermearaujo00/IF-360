{"ts":"2026-11-16T22:43:02.964Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":28401,"action":"execute","params":{"action":"execute","code":"var terrain = Terrain.activeTerrain;\nvar sb = new System.Text.StringBuilder();\nif (terrain == null) {\n    var allTerrains = UnityEngine.Object.FindObjectsByType<Terrain>(FindObjectsInactive.Include, FindObjectsSortMode.None);\n    sb.AppendLine(\"Terrain.activeTerrain is null. Total terrains found: \" + allTerrains.Length);\n    foreach (var t in allTerrains) {\n        sb.AppendLine(string.Format(\"Terrain: '{0}', Active: {1}, Pos: {2}, Size: {3}\",\n            t.gameObject.name, t.gameObject.activeInHierarchy, t.transform.position, t.terrainData != null ? t.terrainData.size.ToString() : \"null\"));\n    }\n} else {\n    var td = terrain.terrainData;\n    sb.AppendLine(string.Format(\"Active Terrain: '{0}', Pos: {1}, Size: {2}\",\n        terrain.gameObject.name, terrain.transform.position, td != null ? td.size.ToString() : \"null\"));\n    if (td != null) {\n        sb.AppendLine(\"Alphamap resolution: \" + td.alphamapResolution + \" (width: \" + td.alphamapWidth + \", height: \" + td.alphamapHeight + \", layers: \" + td.alphamapLayers + \")\");\n        for (int i = 0; i < td.terrainLayers.Length; i++) {\n            var tl = td.terrainLayers[i];\n            sb.AppendLine(string.Format(\"  Layer [{0}]: {1}\", i, tl != null ? tl.name : \"null\"));\n        }\n        sb.AppendLine(\"Tree Prototypes: \" + td.treePrototypes.Length);\n        sb.AppendLine(\"Tree Instances: \" + td.treeInstanceCount);\n        sb.AppendLine(\"Detail Prototypes: \" + td.detailPrototypes.Length);\n    }\n}\n\n// Check mapa_classificado.png\nstring mapPath = \"Assets/Mapas/mapa_classificado.png\";\nvar mapTex = AssetDatabase.LoadAssetAtPath<Texture2D>(mapPath);\nif (mapTex == null) {\n    sb.AppendLine(\"Map texture not found at: \" + mapPath);\n} else {\n    sb.AppendLine(string.Format(\"Map Texture: '{0}' ({1}x{2}) isReadable: {3}\",\n        mapPath, mapTex.width, mapTex.height, mapTex.isReadable));\n}\n\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
