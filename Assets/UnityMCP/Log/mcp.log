{"ts":"2026-11-17T03:12:25.628Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":3345,"action":"execute","params":{"action":"execute","code":"var sb = new System.Text.StringBuilder();\nvar terrain = UnityEngine.Terrain.activeTerrain;\nvar td = terrain.terrainData;\nvar tpos = terrain.transform.position;\nint grassLayer = 0;\nfor (int i = 0; i < td.terrainLayers.Length; i++) {\n    if (td.terrainLayers[i] != null && td.terrainLayers[i].name.ToLower().Contains(\"grama\")) { grassLayer = i; break; }\n}\nvar alpha = td.GetAlphamaps(0, 0, td.alphamapWidth, td.alphamapHeight);\nvar root = UnityEngine.GameObject.Find(\"Grama_S_Grass_01A_Nordeste\");\nsb.Append(\"{\\\"rootExists\\\":\").Append(root != null ? \"true\" : \"false\");\nif (root == null) { sb.Append('}'); return sb.ToString(); }\nsb.Append(\",\\\"rootAtSceneRoot\\\":\").Append(root.transform.parent == null ? \"true\" : \"false\");\nsb.Append(\",\\\"chunks\\\":\").Append(root.transform.childCount);\n\nint total = 0, linked = 0, unlinked = 0, wrongPrefab = 0, outsideRect = 0, splatBad = 0, noRenderer = 0, floating = 0;\nfloat maxErr = 0f, minY = float.MaxValue, maxY = float.MinValue;\nfloat xMin = 363.79f, xMax = 957.50f, zMin = -329.79f, zMax = 195.61f;\nint minPerChunk = int.MaxValue, maxPerChunk = 0;\nforeach (UnityEngine.Transform chunk in root.transform) {\n    if (chunk.childCount < minPerChunk) minPerChunk = chunk.childCount;\n    if (chunk.childCount > maxPerChunk) maxPerChunk = chunk.childCount;\n    foreach (UnityEngine.Transform c in chunk) {\n        total++;\n        var go = c.gameObject;\n        var src = UnityEditor.PrefabUtility.GetCorrespondingObjectFromSource(go);\n        if (src == null) unlinked++;\n        else {\n            linked++;\n            var srcRoot = UnityEditor.PrefabUtility.GetOutermostPrefabInstanceRoot(go);\n            var prefabAsset = UnityEditor.PrefabUtility.GetCorrespondingObjectFromSource(srcRoot != null ? srcRoot : go);\n            if (src.name != \"S_Grass_01A\") wrongPrefab++;\n        }\n        if (c.position.x < xMin || c.position.x > xMax || c.position.z < zMin || c.position.z > zMax) outsideRect++;\n        var rs = go.GetComponentsInChildren<UnityEngine.Renderer>();\n        if (rs.Length == 0) { noRenderer++; continue; }\n        var b = rs[0].bounds;\n        for (int i = 1; i < rs.Length; i++) b.Encapsulate(rs[i].bounds);\n        float gy = terrain.SampleHeight(new UnityEngine.Vector3(c.position.x, 0f, c.position.z)) + tpos.y;\n        float target = gy + 0.06f;\n        float err = UnityEngine.Mathf.Abs(b.min.y - target);\n        if (err > maxErr) maxErr = err;\n        if (b.min.y > gy + 0.15f) floating++;\n        if (b.min.y < minY) minY = b.min.y;\n        if (b.min.y > maxY) maxY = b.min.y;\n        float nx = (c.position.x - tpos.x) / td.size.x;\n        float nz = (c.position.z - tpos.z) / td.size.z;\n        if (nx >= 0f && nx <= 1f && nz >= 0f && nz <= 1f) {\n            int px = UnityEngine.Mathf.Clamp(UnityEngine.Mathf.RoundToInt(nx * (td.alphamapWidth - 1)), 0, td.alphamapWidth - 1);\n            int pz = UnityEngine.Mathf.Clamp(UnityEngine.Mathf.RoundToInt(nz * (td.alphamapHeight - 1)), 0, td.alphamapHeight - 1);\n            if (alpha[pz, px, grassLayer] < 0.55f) splatBad++;\n        } else splatBad++;\n    }\n}\nsb.Append(\",\\\"total\\\":\").Append(total);\nsb.Append(\",\\\"linked\\\":\").Append(linked);\nsb.Append(\",\\\"unlinked\\\":\").Append(unlinked);\nsb.Append(\",\\\"wrongPrefab\\\":\").Append(wrongPrefab);\nsb.Append(\",\\\"outsideRect\\\":\").Append(outsideRect);\nsb.Append(\",\\\"splatBelow055\\\":\").Append(splatBad);\nsb.Append(\",\\\"noRenderer\\\":\").Append(noRenderer);\nsb.Append(\",\\\"floating\\\":\").Append(floating);\nsb.Append(\",\\\"maxSnapErr\\\":\").Append(maxErr.ToString(\"F4\", System.Globalization.CultureInfo.InvariantCulture));\nsb.Append(\",\\\"baseYRange\\\":\\\"\").Append(minY.ToString(\"F3\")).Append(\"..\").Append(maxY.ToString(\"F3\")).Append(\"\\\"\");\nsb.Append(\",\\\"perChunkRange\\\":\\\"\").Append(minPerChunk).Append(\"..\").Append(maxPerChunk).Append(\"\\\"\");\n\nvar veg = UnityEngine.GameObject.Find(\"Vegetacao_Gramado_Nordeste\");\nint trees = 0, bushes = 0, rocks = 0, details = 0;\nif (veg != null) {\n    var t = veg.transform.Find(\"Arvores\"); if (t != null) trees = t.childCount;\n    var b2 = veg.transform.Find(\"Arbustos\"); if (b2 != null) bushes = b2.childCount;\n    var r2 = veg.transform.Find(\"Rochas\"); if (r2 != null) rocks = r2.childCount;\n    var d2 = veg.transform.Find(\"Detalhes\"); if (d2 != null) details = d2.childCount;\n}\nsb.Append(\",\\\"existing\\\":{\\\"trees\\\":\").Append(trees).Append(\",\\\"bushes\\\":\").Append(bushes).Append(\",\\\"rocks\\\":\").Append(rocks).Append(\",\\\"details\\\":\").Append(details).Append(\"}\");\nvar props = UnityEngine.GameObject.Find(\"Terrain_Vegetation_Props\");\nsb.Append(\",\\\"oldPropsChildren\\\":\").Append(props != null ? props.transform.childCount : -1);\nsb.Append(\",\\\"sceneObjects\\\":\").Append(UnityEngine.Object.FindObjectsByType<UnityEngine.GameObject>(UnityEngine.FindObjectsInactive.Include, UnityEngine.FindObjectsSortMode.None).Length);\nsb.Append(\",\\\"sceneDirty\\\":\").Append(UnityEngine.SceneManagement.SceneManager.GetActiveScene().isDirty ? \"true\" : \"false\");\nsb.Append(\",\\\"scene\\\":\\\"\").Append(UnityEngine.SceneManagement.SceneManager.GetActiveScene().path).Append(\"\\\"}\");\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"}}
