{"ts":"2026-11-16T22:57:47.343Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1791,"action":"execute","params":{"action":"execute","code":"var guids = UnityEditor.AssetDatabase.FindAssets(\"t:Texture2D\", new[] { \"Assets\" });\nvar allTextures = new System.Collections.Generic.List<UnityEngine.Texture2D>();\nvar pathMap = new System.Collections.Generic.Dictionary<UnityEngine.Texture2D, string>();\n\nforeach (var guid in guids) {\n    string path = UnityEditor.AssetDatabase.GUIDToAssetPath(guid);\n    if (path.StartsWith(\"Assets/Mapas\")) continue;\n    var tex = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Texture2D>(path);\n    if (tex != null) {\n        allTextures.Add(tex);\n        pathMap[tex] = path;\n    }\n}\n\n// Helper function to find best texture and normal\nSystem.Func<string[], System.Tuple<UnityEngine.Texture2D, UnityEngine.Texture2D>> findCategory = (keywords) => {\n    UnityEngine.Texture2D bestDiffuse = null;\n    int maxResolution = 0;\n    \n    foreach (var tex in allTextures) {\n        string path = pathMap[tex];\n        string lowerName = System.IO.Path.GetFileNameWithoutExtension(path).ToLower();\n        string lowerPath = path.ToLower();\n        \n        // Exclude billboards, UI, alpha sheets, normal maps themselves, signs\n        if (lowerPath.Contains(\"alphas\") || lowerName.Contains(\"_normal\") || lowerName.Contains(\"_nor\") || \n            lowerName.Contains(\"_n_\") || lowerName.EndsWith(\"_n\") || lowerName.Contains(\"sign\") || lowerName.Contains(\"rough\")) {\n            continue;\n        }\n        \n        bool matches = false;\n        foreach (var kw in keywords) {\n            if (lowerName.Contains(kw.ToLower())) {\n                matches = true;\n                break;\n            }\n        }\n        \n        if (matches) {\n            int res = tex.width * tex.height;\n            if (res > maxResolution) {\n                maxResolution = res;\n                bestDiffuse = tex;\n            }\n        }\n    };\n    \n    UnityEngine.Texture2D bestNormal = null;\n    if (bestDiffuse != null) {\n        string diffPath = pathMap[bestDiffuse];\n        string diffDir = System.IO.Path.GetDirectoryName(diffPath);\n        string diffBase = System.IO.Path.GetFileNameWithoutExtension(diffPath).ToLower();\n        \n        // Try companion normal map in same directory or by name\n        foreach (var tex in allTextures) {\n            string p = pathMap[tex];\n            string nName = System.IO.Path.GetFileNameWithoutExtension(p).ToLower();\n            string nDir = System.IO.Path.GetDirectoryName(p);\n            \n            var imp = UnityEditor.AssetImporter.GetAtPath(p) as UnityEditor.TextureImporter;\n            bool isNormalType = (imp != null && imp.textureType == UnityEditor.TextureImporterType.NormalMap) ||\n                                nName.Contains(\"normal\") || nName.Contains(\"_nor\") || nName.EndsWith(\"_n\") || nName.Contains(\"_n_\");\n            \n            if (!isNormalType) continue;\n            \n            // Priority 1: same directory and matches base name\n            if (nDir == diffDir) {\n                bestNormal = tex;\n                break;\n            }\n        }\n    }\n    \n    return System.Tuple.Create(bestDiffuse, bestNormal);\n};\n\nvar grass = findCategory(new[] { \"grass\", \"grama\", \"lawn\", \"turf\", \"foliage_ground\" });\nvar asphalt = findCategory(new[] { \"asphalt\", \"asfalto\", \"road\", \"concrete\", \"pavement\", \"street\" });\nvar dirt = findCategory(new[] { \"dirt\", \"terra\", \"soil\", \"sand\", \"mud\", \"ground\" });\n\nreturn \"Grass: \" + (grass.Item1 != null ? grass.Item1.name + \" (\" + grass.Item1.width + \"x\" + grass.Item1.height + \") at \" + pathMap[grass.Item1] + \" | Normal: \" + (grass.Item2 != null ? grass.Item2.name : \"null\") : \"Fallback\") +\n       \"\\nAsphalt: \" + (asphalt.Item1 != null ? asphalt.Item1.name + \" (\" + asphalt.Item1.width + \"x\" + asphalt.Item1.height + \") at \" + pathMap[asphalt.Item1] + \" | Normal: \" + (asphalt.Item2 != null ? asphalt.Item2.name : \"null\") : \"Fallback\") +\n       \"\\nDirt: \" + (dirt.Item1 != null ? dirt.Item1.name + \" (\" + dirt.Item1.width + \"x\" + dirt.Item1.height + \") at \" + pathMap[dirt.Item1] + \" | Normal: \" + (dirt.Item2 != null ? dirt.Item2.name : \"null\") : \"Fallback\");","safety_checks":true,"compiler":"auto"}}
