{"ts":"2026-11-16T22:31:17.388Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":37132,"action":"execute","params":{"action":"execute","code":"// ============================================================\n// Lead Lighting Artist — Setup Campus Base Lighting\n// Scene: Campus.unity\n// ============================================================\n\n// 1. Undo & Group Setup\nUndo.IncrementCurrentGroup();\nUndo.SetCurrentGroupName(\"Setup Campus Base Lighting\");\nint undoGroup = Undo.GetCurrentGroup();\n\n// Check Render Pipeline\nvar srp = UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline;\nstring pipelineName = (srp != null) ? srp.GetType().Name : \"Built-in\";\n\n// 2. Find or Create Main Directional Light\nvar allLights = UnityEngine.Object.FindObjectsByType<Light>(FindObjectsInactive.Include, FindObjectsSortMode.None);\nLight mainDirLight = null;\nfloat maxIntensity = -1f;\n\nforeach (var l in allLights)\n{\n    if (l != null && l.type == LightType.Directional)\n    {\n        if (l.intensity > maxIntensity)\n        {\n            maxIntensity = l.intensity;\n            mainDirLight = l;\n        }\n    }\n}\n\nbool createdNew = false;\nif (mainDirLight == null)\n{\n    var lightGO = new GameObject(\"Directional Light\", typeof(Light));\n    mainDirLight = lightGO.GetComponent<Light>();\n    mainDirLight.type = LightType.Directional;\n    Undo.RegisterCreatedObjectUndo(lightGO, \"Create Directional Light\");\n    createdNew = true;\n}\nelse\n{\n    Undo.RecordObject(mainDirLight, \"Configure Directional Light\");\n    Undo.RecordObject(mainDirLight.transform, \"Rotate Directional Light\");\n}\n\n// Configure Directional Light properties\nmainDirLight.transform.rotation = Quaternion.Euler(35f, 110f, 0f);\nmainDirLight.intensity = 1.25f;\nmainDirLight.color = new Color(1.0f, 0.96f, 0.88f);\nmainDirLight.shadows = LightShadows.Soft;\nmainDirLight.shadowStrength = 0.85f;\nmainDirLight.shadowResolution = UnityEngine.Rendering.LightShadowResolution.High;\nmainDirLight.shadowBias = 0.05f;\nmainDirLight.shadowNormalBias = 0.4f;\nmainDirLight.lightmapBakeType = LightmapBakeType.Realtime;\n\nEditorUtility.SetDirty(mainDirLight);\nEditorUtility.SetDirty(mainDirLight.transform);\n\n// 3. Environment Lighting (RenderSettings)\nRenderSettings.ambientMode = UnityEngine.Rendering.AmbientMode.Trilight;\nRenderSettings.ambientSkyColor = new Color(0.75f, 0.85f, 1.0f);\nRenderSettings.ambientEquatorColor = new Color(0.90f, 0.84f, 0.76f);\nRenderSettings.ambientGroundColor = new Color(0.22f, 0.22f, 0.25f);\n\n// 4. Update Dynamic GI and Environment Probes\nDynamicGI.UpdateEnvironment();\n\n// Finalize Undo & Scene Save\nUndo.CollapseUndoOperations(undoGroup);\nvar activeScene = UnityEditor.SceneManagement.EditorSceneManager.GetActiveScene();\nUnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(activeScene);\nUnityEditor.SceneManagement.EditorSceneManager.SaveScene(activeScene);\n\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"SUCCESS\");\nsb.AppendLine(\"Pipeline: \" + pipelineName);\nsb.AppendLine(\"DirectionalLight: \" + mainDirLight.gameObject.name + (createdNew ? \" (Criada nova)\" : \" (Existente configurada)\"));\nsb.AppendLine(\"Rotation: \" + mainDirLight.transform.rotation.eulerAngles.ToString());\nsb.AppendLine(\"Intensity: \" + mainDirLight.intensity);\nsb.AppendLine(\"Color: \" + mainDirLight.color.ToString());\nsb.AppendLine(\"Shadows: \" + mainDirLight.shadows);\nsb.AppendLine(\"ShadowStrength: \" + mainDirLight.shadowStrength);\nsb.AppendLine(\"ShadowResolution: \" + mainDirLight.shadowResolution);\nsb.AppendLine(\"ShadowBias: \" + mainDirLight.shadowBias);\nsb.AppendLine(\"ShadowNormalBias: \" + mainDirLight.shadowNormalBias);\nsb.AppendLine(\"LightmapBakeType: \" + mainDirLight.lightmapBakeType);\nsb.AppendLine(\"AmbientMode: \" + RenderSettings.ambientMode);\nsb.AppendLine(\"AmbientSkyColor: \" + RenderSettings.ambientSkyColor.ToString());\nsb.AppendLine(\"AmbientEquatorColor: \" + RenderSettings.ambientEquatorColor.ToString());\nsb.AppendLine(\"AmbientGroundColor: \" + RenderSettings.ambientGroundColor.ToString());\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
