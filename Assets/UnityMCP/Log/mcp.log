{"ts":"2026-11-16T23:14:49.137Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":28919,"action":"execute","params":{"action":"execute","code":"var guids = UnityEditor.AssetDatabase.FindAssets(\"t:Prefab\", new[] { \"Assets\" });\n\nSystem.Func<UnityEngine.GameObject, int> getVertexCount = (go) => {\n    int count = 0;\n    var mfs = go.GetComponentsInChildren<UnityEngine.MeshFilter>(true);\n    foreach (var mf in mfs) {\n        if (mf.sharedMesh != null) count += mf.sharedMesh.vertexCount;\n    }\n    return count;\n};\n\nvar treeKeywords = new[] { \"tree\", \"arvore\", \"pine\", \"oak\", \"palm\", \"bush_large\" };\nvar rockKeywords = new[] { \"rock\", \"stone\", \"pedra\", \"boulder\", \"pebble\" };\nvar grassKeywords = new[] { \"grass\", \"grama\", \"plant\", \"weed\", \"fern\", \"bush\" };\n\nvar treeList = new System.Collections.Generic.List<System.Tuple<string, int, UnityEngine.GameObject>>();\nvar rockList = new System.Collections.Generic.List<System.Tuple<string, int, UnityEngine.GameObject>>();\nvar grassList = new System.Collections.Generic.List<System.Tuple<string, int, UnityEngine.GameObject>>();\n\nforeach (var g in guids) {\n    string p = UnityEditor.AssetDatabase.GUIDToAssetPath(g);\n    string n = System.IO.Path.GetFileNameWithoutExtension(p).ToLower();\n    \n    // Exclude unwanted\n    if (n.Contains(\"sign\") || n.Contains(\"street\") || n.Contains(\"bench\") || n.Contains(\"lamp\") || \n        n.Contains(\"bin\") || n.Contains(\"wall\") || n.Contains(\"rocket\") || n.Contains(\"trunk\") ||\n        n.Contains(\"fallen\") || n.Contains(\"potted\")) continue;\n        \n    var go = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.GameObject>(p);\n    if (go == null) continue;\n    int vc = getVertexCount(go);\n    if (vc == 0) continue;\n    \n    foreach (var k in treeKeywords) {\n        if (n.Contains(k)) { treeList.Add(System.Tuple.Create(p, vc, go)); break; }\n    }\n    foreach (var k in rockKeywords) {\n        if (n.Contains(k)) { rockList.Add(System.Tuple.Create(p, vc, go)); break; }\n    }\n    foreach (var k in grassKeywords) {\n        if (n.Contains(k)) { grassList.Add(System.Tuple.Create(p, vc, go)); break; }\n    }\n}\n\ntreeList.Sort((a, b) => b.Item2.CompareTo(a.Item2));\nrockList.Sort((a, b) => b.Item2.CompareTo(a.Item2));\ngrassList.Sort((a, b) => b.Item2.CompareTo(a.Item2));\n\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"TOP TREES:\");\nfor (int i = 0; i < System.Math.Min(5, treeList.Count); i++) {\n    sb.AppendLine(\"  \" + treeList[i].Item3.name + \" (\" + treeList[i].Item2 + \" verts) @ \" + treeList[i].Item1);\n}\n\nsb.AppendLine(\"\\nTOP ROCKS:\");\nfor (int i = 0; i < System.Math.Min(5, rockList.Count); i++) {\n    sb.AppendLine(\"  \" + rockList[i].Item3.name + \" (\" + rockList[i].Item2 + \" verts) @ \" + rockList[i].Item1);\n}\n\nsb.AppendLine(\"\\nTOP GRASS / BUSHES:\");\nfor (int i = 0; i < System.Math.Min(5, grassList.Count); i++) {\n    sb.AppendLine(\"  \" + grassList[i].Item3.name + \" (\" + grassList[i].Item2 + \" verts) @ \" + grassList[i].Item1);\n}\n\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
