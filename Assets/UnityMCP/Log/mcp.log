{"ts":"2026-11-16T22:48:57.160Z","tool":"execute_code","type":"tool","status":"ERROR","ms":13406,"action":"execute","params":{"action":"execute","code":"var guids = AssetDatabase.FindAssets(\"t:Texture2D\", new[] { \"Assets\" });\n\nclass FoundTex {\n    public string path;\n    public Texture2D diffuse;\n    public Texture2D normal;\n    public int res;\n}\n\nFoundTex FindBestTexture(string[] keywords) {\n    FoundTex best = null;\n    int maxRes = -1;\n\n    foreach (var guid in guids) {\n        string p = AssetDatabase.GUIDToAssetPath(guid);\n        if (p.StartsWith(\"Assets/Mapas\", System.StringComparison.OrdinalIgnoreCase)) continue;\n        if (p.EndsWith(\".asset\", System.StringComparison.OrdinalIgnoreCase)) continue;\n\n        string fileName = System.IO.Path.GetFileNameWithoutExtension(p).ToLowerInvariant();\n        var imp = AssetImporter.GetAtPath(p) as TextureImporter;\n        bool isNormal = (imp != null && imp.textureType == TextureImporterType.NormalMap) ||\n                        fileName.EndsWith(\"_normal\") || fileName.EndsWith(\"_n\") || fileName.Contains(\"nor_gl\");\n\n        // Skip normal maps as primary diffuse candidates\n        if (isNormal) continue;\n\n        bool matches = false;\n        foreach (var k in keywords) {\n            if (fileName.Contains(k)) { matches = true; break; }\n        }\n        if (!matches) continue;\n\n        var tex = AssetDatabase.LoadAssetAtPath<Texture2D>(p);\n        if (tex == null) continue;\n\n        int res = tex.width * tex.height;\n        if (res > maxRes) {\n            maxRes = res;\n            best = new FoundTex { path = p, diffuse = tex, res = res };\n        }\n    }\n\n    if (best != null) {\n        // Search for matching normal map\n        string dir = System.IO.Path.GetDirectoryName(best.path);\n        string baseName = System.IO.Path.GetFileNameWithoutExtension(best.path);\n        // Look for companion files in the same directory or project\n        foreach (var guid in guids) {\n            string np = AssetDatabase.GUIDToAssetPath(guid);\n            if (!np.StartsWith(dir, System.StringComparison.OrdinalIgnoreCase)) continue;\n            string nName = System.IO.Path.GetFileNameWithoutExtension(np).ToLowerInvariant();\n            var nImp = AssetImporter.GetAtPath(np) as TextureImporter;\n            bool isN = (nImp != null && nImp.textureType == TextureImporterType.NormalMap) ||\n                       nName.Contains(\"_nor\") || nName.Contains(\"_n\") || nName.Contains(\"normal\");\n            if (isN) {\n                var nTex = AssetDatabase.LoadAssetAtPath<Texture2D>(np);\n                if (nTex != null) {\n                    best.normal = nTex;\n                    break;\n                }\n            }\n        }\n    }\n\n    return best;\n}\n\nvar grass = FindBestTexture(new[] { \"grass\", \"grama\", \"lawn\", \"turf\", \"foliage_ground\" });\nvar asphalt = FindBestTexture(new[] { \"asphalt\", \"asfalto\", \"road\", \"concrete\", \"pavement\", \"street\" });\nvar dirt = FindBestTexture(new[] { \"dirt\", \"terra\", \"soil\", \"sand\", \"mud\", \"ground\" });\n\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"Grama: \" + (grass != null ? (grass.diffuse.name + \" (\" + grass.diffuse.width + \"x\" + grass.diffuse.height + \"), Normal: \" + (grass.normal != null ? grass.normal.name : \"null\")) : \"Fallback\"));\nsb.AppendLine(\"Asfalto: \" + (asphalt != null ? (asphalt.diffuse.name + \" (\" + asphalt.diffuse.width + \"x\" + asphalt.diffuse.height + \"), Normal: \" + (asphalt.normal != null ? asphalt.normal.name : \"null\")) : \"Fallback\"));\nsb.AppendLine(\"Terra: \" + (dirt != null ? (dirt.diffuse.name + \" (\" + dirt.diffuse.width + \"x\" + dirt.diffuse.height + \"), Normal: \" + (dirt.normal != null ? dirt.normal.name : \"null\")) : \"Fallback\"));\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"},"error":"Compilation failed"}
