{"ts":"2026-11-16T22:47:35.883Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":11789,"action":"execute","params":{"action":"execute","code":"var guids = AssetDatabase.FindAssets(\"t:Texture2D\", new[] { \"Assets\" });\nvar sb = new System.Text.StringBuilder();\n\nstring[] grassKeys = new[] { \"grass\", \"grama\", \"lawn\", \"turf\", \"foliage_ground\" };\nstring[] asphaltKeys = new[] { \"asphalt\", \"asfalto\", \"road\", \"concrete\", \"pavement\", \"street\" };\nstring[] dirtKeys = new[] { \"dirt\", \"terra\", \"soil\", \"sand\", \"mud\", \"ground\" };\n\nvar grassList = new System.Collections.Generic.List<string>();\nvar asphaltList = new System.Collections.Generic.List<string>();\nvar dirtList = new System.Collections.Generic.List<string>();\n\nforeach (var guid in guids) {\n    string p = AssetDatabase.GUIDToAssetPath(guid);\n    if (p.StartsWith(\"Assets/Mapas\", System.StringComparison.OrdinalIgnoreCase)) continue;\n    string name = System.IO.Path.GetFileNameWithoutExtension(p).ToLowerInvariant();\n    \n    // Check if normal map\n    var imp = AssetImporter.GetAtPath(p) as TextureImporter;\n    bool isNormal = (imp != null && imp.textureType == TextureImporterType.NormalMap) ||\n                    name.EndsWith(\"_normal\") || name.EndsWith(\"_n\") || name.Contains(\"normal\");\n\n    var tex = AssetDatabase.LoadAssetAtPath<Texture2D>(p);\n    if (tex == null) continue;\n    int res = tex.width * tex.height;\n    string info = string.Format(\"{0} ({1}x{2}, isNormal: {3}) @ {4}\", System.IO.Path.GetFileName(p), tex.width, tex.height, isNormal, p);\n\n    foreach (var k in grassKeys) {\n        if (name.Contains(k)) { grassList.Add(info); break; }\n    }\n    foreach (var k in asphaltKeys) {\n        if (name.Contains(k)) { asphaltList.Add(info); break; }\n    }\n    foreach (var k in dirtKeys) {\n        if (name.Contains(k)) { dirtList.Add(info); break; }\n    }\n}\n\nsb.AppendLine(\"=== GRASS (\" + grassList.Count + \") ===\");\nfor (int i = 0; i < System.Math.Min(10, grassList.Count); i++) sb.AppendLine(\"  \" + grassList[i]);\n\nsb.AppendLine(\"=== ASPHALT (\" + asphaltList.Count + \") ===\");\nfor (int i = 0; i < System.Math.Min(10, asphaltList.Count); i++) sb.AppendLine(\"  \" + asphaltList[i]);\n\nsb.AppendLine(\"=== DIRT (\" + dirtList.Count + \") ===\");\nfor (int i = 0; i < System.Math.Min(10, dirtList.Count); i++) sb.AppendLine(\"  \" + dirtList[i]);\n\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
